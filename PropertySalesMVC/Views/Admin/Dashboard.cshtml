@model List<PropertyViewModel>

@{
    ViewData["Title"] = "All Properties";
    Layout = "_AdminLayout";

    string ModeLabel(int lookingFor) => lookingFor switch
    {
        1 => "Rent",
        2 => "Buy",
        3 => "Sell",
        _ => "—"
    };

    string? search = ViewBag.Search as string;
    int? lookingForFilter = ViewBag.LookingFor as int?;
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-properties.css" asp-append-version="true" />
}

<div class="admin-topline">
    <div>
        <span class="eyebrow">All Listings</span>
        <h2 class="page-title">Properties (@ViewBag.PropertyCount)</h2>
    </div>
    <a href="/Admin/AddProperty" class="btn btn-primary">+ Add Property</a>
</div>

<form method="get" class="toolbar-row">
    <input type="text" name="search" value="@search" class="form-control" placeholder="Search by title..." />
    <select name="lookingFor" class="form-select">
        <option value="">All Types</option>
        <option value="1" selected="@(lookingForFilter == 1 ? "selected" : null)">Rent</option>
        <option value="2" selected="@(lookingForFilter == 2 ? "selected" : null)">Buy</option>
        <option value="3" selected="@(lookingForFilter == 3 ? "selected" : null)">Sell</option>
    </select>
    <button type="submit" class="btn btn-secondary text-nowrap">Filter</button>
</form>

<div class="property-grid">

    @foreach (var property in Model)
    {
        <div class="property-card">

            <!-- IMAGE -->
            <div class="image-wrapper">
                @if (property.Images?.Any() == true)
                {
                    <img src="@property.Images.First()" loading="lazy" />
                }
                else
                {
                    <img src="~/images/no-image.png" />
                }
            </div>

            <!-- CONTENT -->
            <div class="card-body">
                <span class="badge">@ModeLabel(property.LookingFor)</span>
                <h5>@property.Title</h5>

                <p class="location">@property.Location</p>

                <p class="price">₹ @property.Price.ToString("N0", new System.Globalization.CultureInfo("en-IN"))</p>

                <p class="desc">@property.Description</p>

                <div class="actions">
                    <a href="/Property/EditProperty/@property.PropertyId"
                       class="btn btn-sm btn-outline-primary">
                        Edit
                    </a>

                    @* <a href="/Admin/DeleteProperty/@property.PropertyId"
                       class="btn btn-sm btn-outline-danger">
                        Delete
                    </a> *@

                    <form asp-action="DeleteProperty"
                          asp-controller="Admin"
                          method="post"
                          onsubmit="return confirm('Permanently delete this property? This cannot be undone.');"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="propertyId" value="@property.PropertyId" />

                        <button type="submit"
                                class="btn btn-sm btn-outline-danger">
                            Delete
                        </button>
                    </form>
                </div>
            </div>

        </div>
    }

</div>

@if (!Model.Any())
{
    <p class="text-muted">No properties match this filter.</p>
}

@if (ViewBag.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")"
               href="@Url.Action("Dashboard", new { search, lookingFor = lookingForFilter, page = i })">@i</a>
        }
    </div>
}

@if (TempData["PropertyUpdateMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">
        <div id="successToast"
     class="toast toast-admin-success align-items-center border-0"
     role="alert"
     aria-live="assertive"
     aria-atomic="true">

    <div class="toast-accent"></div>

    <div class="d-flex flex-grow-1">
        <div class="toast-body">
            @TempData["PropertyUpdateMessage"]
        </div>

        <button type="button"
                class="btn-close btn-close-white me-3 m-auto"
                data-bs-dismiss="toast"
                aria-label="Close">
        </button>
    </div>
</div>

    </div>
}
@if (TempData["PropertyDeletedMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">
        <div id="successToast"
     class="toast toast-admin-success align-items-center border-0"
     role="alert"
     aria-live="assertive"
     aria-atomic="true">

    <div class="toast-accent"></div>

    <div class="d-flex flex-grow-1">
        <div class="toast-body">
            @TempData["PropertyDeletedMessage"]
        </div>

        <button type="button"
                class="btn-close btn-close-white me-3 m-auto"
                data-bs-dismiss="toast"
                aria-label="Close">
        </button>
    </div>
</div>

    </div>
}
@if (TempData["PropertyAddedMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1100">
        <div id="successToast"
     class="toast toast-admin-success align-items-center border-0"
     role="alert"
     aria-live="assertive"
     aria-atomic="true">

    <div class="toast-accent"></div>

    <div class="d-flex flex-grow-1">
        <div class="toast-body">
            @TempData["PropertyAddedMessage"]
        </div>

        <button type="button"
                class="btn-close btn-close-white me-3 m-auto"
                data-bs-dismiss="toast"
                aria-label="Close">
        </button>
    </div>
</div>

    </div>
}



@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const toastEl = document.getElementById("successToast");
        if (toastEl) {
            const toast = new bootstrap.Toast(toastEl, {
                delay: 3000 // 3 seconds
            });
            toast.show();
        }
    });
    </script>
}
