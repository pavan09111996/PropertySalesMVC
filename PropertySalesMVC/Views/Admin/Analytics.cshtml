@model AnalyticsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Analytics";
    Layout = "_AdminLayout";

    // Built here (not in the service) purely as a JSON shape for the chart JS —
    // property names are deliberately lowerCamelCase to match wwwroot/js/analytics.js
    // without needing a serializer naming policy.
    var chartData = new
    {
        locations = Model.TopLocations.Select(l => new { label = l.LocationName, buy = l.BuyViews, rent = l.RentViews }),
        bhk = Model.TopBhk.Select(b => new { label = b.BhkLabel, buy = b.BuyViews, rent = b.RentViews }),
        heatmap = new
        {
            bhkColumns = Model.Heatmap.BhkColumns,
            rows = Model.Heatmap.Rows.Select(r => new { locationName = r.LocationName, buyValues = r.BuyValues, rentValues = r.RentValues }),
            maxBuyValue = Model.Heatmap.MaxBuyValue,
            maxRentValue = Model.Heatmap.MaxRentValue
        },
        trend = Model.DailyTrend.Select(d => new { date = d.ViewDate.ToString("dd MMM"), total = d.TotalViews })
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-analytics.css" asp-append-version="true" />
}

<span class="eyebrow">Market Intent</span>
<h2 class="page-title">Analytics</h2>
<p class="text-muted">Anonymous listing views by location and BHK &mdash; no personal data is collected, since visitors are never required to log in. The same visitor re-checking the same search only counts once per day.</p>

<div class="analytics-range">
    <a class="range-btn @(Model.DaysRange == 7 ? "active" : "")" href="@Url.Action("Analytics", new { days = 7 })">7 days</a>
    <a class="range-btn @(Model.DaysRange == 30 ? "active" : "")" href="@Url.Action("Analytics", new { days = 30 })">30 days</a>
    <a class="range-btn @(Model.DaysRange == 90 ? "active" : "")" href="@Url.Action("Analytics", new { days = 90 })">90 days</a>
</div>

<div class="stat-row">
    <div class="stat-tile">
        <span class="eyebrow">Total Views</span>
        <strong class="tabular">@Model.TotalViews</strong>
    </div>
    <div class="stat-tile">
        <span class="eyebrow">Buy</span>
        <strong class="tabular">@Model.BuyViews</strong>
    </div>
    <div class="stat-tile">
        <span class="eyebrow">Rent</span>
        <strong class="tabular">@Model.RentViews</strong>
    </div>
</div>

@if (Model.TotalViews == 0)
{
    <p class="text-muted">No listing views recorded yet in this range.</p>
}
else
{
    <div class="section">
        <div class="section-head">
            <h2>Top Locations</h2>
            <div class="section-tools">
                <div class="legend">
                    <span class="key"><span class="swatch buy"></span>Buy</span>
                    <span class="key"><span class="swatch rent"></span>Rent</span>
                </div>
                <button class="table-toggle" data-toggle="locations">View as table</button>
            </div>
        </div>
        <div class="bar-chart" id="locations-chart"></div>
        <table class="data-table" id="locations-table">
            <thead><tr><th>Location</th><th>Buy</th><th>Rent</th><th>Total</th></tr></thead>
            <tbody id="locations-tbody"></tbody>
        </table>
    </div>

    <div class="section">
        <div class="section-head">
            <h2>Top BHK</h2>
            <div class="section-tools">
                <div class="legend">
                    <span class="key"><span class="swatch buy"></span>Buy</span>
                    <span class="key"><span class="swatch rent"></span>Rent</span>
                </div>
                <button class="table-toggle" data-toggle="bhk">View as table</button>
            </div>
        </div>
        <div class="bar-chart" id="bhk-chart"></div>
        <table class="data-table" id="bhk-table">
            <thead><tr><th>BHK</th><th>Buy</th><th>Rent</th><th>Total</th></tr></thead>
            <tbody id="bhk-tbody"></tbody>
        </table>
    </div>

    <div class="section">
        <div class="section-head"><h2>Location &times; BHK</h2></div>
        <p class="text-muted" style="margin-bottom:18px;">The two charts above are separate totals &mdash; this is the actual intersection. Darker = more views for that exact location-and-BHK combination.</p>
        <div class="heatmap-pair">
            <div class="heatmap-block">
                <div class="hm-title"><span class="swatch buy"></span>Buy</div>
                <table class="heatmap" id="heatmap-buy"></table>
            </div>
            <div class="heatmap-block">
                <div class="hm-title"><span class="swatch rent"></span>Rent</div>
                <table class="heatmap" id="heatmap-rent"></table>
            </div>
        </div>
    </div>

    <div class="section">
        <div class="section-head"><h2>Daily Trend</h2></div>
        <div class="trend-card">
            <svg class="trend-svg" id="trend-svg" viewBox="0 0 640 180" preserveAspectRatio="none"></svg>
        </div>
    </div>
}

<div class="tooltip" id="tooltip"></div>

@section Scripts {
    <script>
        window.analyticsData = @Html.Raw(JsonSerializer.Serialize(chartData));
    </script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
}
