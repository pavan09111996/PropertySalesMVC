@model List<PropertySalesMVC.Models.LocationOption>
@{
    ViewData["Title"] = "Locations";
    Layout = "_AdminLayout";
}

@{ int i = 0; }

<span class="eyebrow">Filter Options</span>
<h2 class="page-title">Locations</h2>
<p class="text-muted">Order here is the order shown in every location dropdown across the site.</p>

@if (TempData["LocationMessage"] != null)
{
    <div class="alert alert-success">@TempData["LocationMessage"]</div>
}

<div class="loc-list">
    @foreach (var loc in Model)
    {
        i++;
        <form asp-action="UpdateLocation" asp-controller="Admin" method="post" class="loc-row">
            @Html.AntiForgeryToken()
            <span class="order tabular">@i.ToString("00")</span>
            <input type="hidden" name="id" value="@loc.Id" />
            <input type="text" name="name" value="@loc.Location" required />

            <label class="loc-toggle">
                <input class="form-check-input" type="checkbox" name="isActive" value="true" @(loc.IsActive ? "checked" : "") />
                Active
            </label>

            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
        </form>
    }

    <form asp-action="CreateLocation" asp-controller="Admin" method="post" class="add-loc">
        @Html.AntiForgeryToken()
        <input type="text" name="name" placeholder="New location name..." required />
        <button type="submit" class="btn btn-sm btn-secondary text-nowrap">Add</button>
    </form>
</div>
