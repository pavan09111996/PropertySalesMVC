@model List<PropertySalesMVC.Models.Enquiry>
@{
    ViewData["Title"] = "Enquiries";
    Layout = "_AdminLayout";
}

<span class="eyebrow">Leads</span>
<h2 class="page-title">Enquiries</h2>
<p class="text-muted">Every WhatsApp contact, property inquiry, and "sell my property" submission, captured here.</p>

@if (!Model.Any())
{
    <p class="text-muted">No enquiries yet.</p>
}
else
{
    <table class="table table-bordered bg-white">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Property</th>
                <th>From</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.CreatedOn.ToString("dd MMM yyyy, HH:mm")</td>
                    <td><span class="chip chip-type">@e.EnquiryType</span></td>
                    <td>
                        @if (e.PropertyId.HasValue)
                        {
                            <a href="@Url.Action("PropertyDetails", "Property", new { id = e.PropertyId })" target="_blank">
                                @(e.PropertyTitle ?? $"#{e.PropertyId}")
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(e.Name) || !string.IsNullOrEmpty(e.Phone))
                        {
                            <div>@e.Name</div>
                            <div class="text-muted">@e.Phone</div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(e.Message))
                        {
                            @e.Message
                        }
                        else if (!string.IsNullOrEmpty(e.Title))
                        {
                            <div>@e.Title @(e.BHK.HasValue ? $"({e.BHK} BHK)" : "")</div>
                            <div class="text-muted">
                                @(e.Price.HasValue ? $"₹{e.Price.Value.ToString("N0", new System.Globalization.CultureInfo("en-IN"))}" : "")
                                @e.Description
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")"
                   href="@Url.Action("Enquiries", new { page = i })">@i</a>
            }
        </div>
    }
}
