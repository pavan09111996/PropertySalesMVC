@{
    ViewData["Title"] = "Ronak Estate - Find Your Dream Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" />
}

<section class="hero hero-video">

    <video class="hero-bg-video"
           autoplay muted loop playsinline preload="metadata"
           poster="/images/hero-fallback.jpg">
        <source src="/videos/realestate-timelapse.mp4" type="video/mp4" />
    </video>

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <h1 id="mainHeading">
            Find Your Place. <span class="gold-accent">Live Better.</span>
        </h1>

        <div class="hero-switch">
            <button onclick="loadProperties('Buy', this)">Buy</button>
            <button onclick="loadProperties('Rent', this)">Rent</button>
            <button onclick="loadSell()">Sell</button>
        </div>

        <p id="modeSubText">
            Buy, rent, or sell premium properties with confidence
        </p>

    </div>
</section>

<!-- FILTER -->
<div id="filterContainer"></div>

<!-- LOADER -->
<div id="propertyLoader" class="property-loader" style="display:none;">
    <div class="spinner"></div>
    <p>Loading properties...</p>
</div>

<!-- CONTENT -->
<div id="contentAnchor"></div>

<section id="propertyContainer"></section>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    var currentMode = null;
    var currentPage = 1;

    function loadProperties(mode, el) {

        currentMode = mode;
        currentPage = 1;

        $('#mainHeading').html(
            'Explore Properties for <span class="gold-accent">' + mode + '</span>'
        );

        $('#modeSubText').text(
            'Handpicked premium properties available for ' + mode.toLowerCase()
        );

        $('.hero-switch button').removeClass('active');
        el.classList.add('active');

        $('#filterContainer').show();
        $('#propertyContainer').empty();
        $('#propertyLoader').show();

        // ✅ Load filter ONLY into filterContainer
        $.get('/Property/FilterPartial', { mode: mode })
            .done(function (html) {
                $('#filterContainer').html(html);
            });

        // ✅ Load listings
        $.ajax({
            url: '/Property/ListingPartial',
            type: 'GET',
            data: {
                mode: currentMode,
                page: currentPage
            }
        })
        .done(function (html) {
            $('#propertyContainer').html(html);
            scrollToContent();
        })
        .always(function () {
            $('#propertyLoader').hide();
        });
    }

    function applyFilters() {

        currentPage = 1;

        let data = {
            mode: currentMode,
            page: currentPage
        };

        if ($('#filterForm').length) {
            $('#filterForm').serializeArray()
                .forEach(x => data[x.name] = x.value);
        }

        $('#propertyContainer').empty();
        $('#propertyLoader').show();

        $.ajax({
            url: '/Property/ListingPartial',
            type: 'GET',
            data: data
        })
        .done(function (html) {
            $('#propertyContainer').html(html);
            scrollToContent();
        })
        .always(function () {
            $('#propertyLoader').hide();
        });
    }

    function changePage(page) {

        if (!currentMode || page < 1) return;

        currentPage = page;

        let data = {
            mode: currentMode,
            page: currentPage
        };

        if ($('#filterForm').length) {
            $('#filterForm').serializeArray()
                .forEach(x => data[x.name] = x.value);
        }

        $('#propertyContainer').empty();
        $('#propertyLoader').show();

        $.ajax({
            url: '/Property/ListingPartial',
            type: 'GET',
            data: data
        })
        .done(function (html) {
            $('#propertyContainer').html(html);
            scrollToContent();
        })
        .always(function () {
            $('#propertyLoader').hide();
        });
    }

    function loadSell() {

        $('.hero-switch button').removeClass('active');
        $('.hero-switch button:last-child').addClass('active');

        $('#filterContainer').hide();

        $('#mainHeading').html(
            'Submit Property for <span class="gold-accent">Sale</span>'
        );

        $('#modeSubText').text(
            'Share your property details and we will contact you'
        );

        $('#propertyContainer').load('/Property/SalePartial', function () {
            scrollToContent(); // ✅ FIX
        });
    }

    function scrollToContent() {

    const anchor = document.getElementById("contentAnchor");
    if (!anchor) return;

    const yOffset = -20; // small breathing space (adjust if needed)
    const y = anchor.getBoundingClientRect().top + window.pageYOffset + yOffset;

    window.scrollTo({
        top: y,
        behavior: "smooth"
    });
}

</script>
}
