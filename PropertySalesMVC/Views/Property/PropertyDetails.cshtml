@model PropertyViewModel

@{
    var currentUrl =
        $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";

    var message =
        $"Hi, I am interested in this property.\n\n{currentUrl}";

    string whatsAppNumber = ViewBag.WhatsAppNumber ?? "";

    var whatsappUrl =
        $"https://wa.me/{whatsAppNumber}?text=" +
        Uri.EscapeDataString(message);
}

<link rel="stylesheet" href="~/css/property-details.css" asp-append-version="true" />
<section class="property-page-isolation details-page">

<section class="property-details-wrapper">

    <!-- LEFT : MEDIA -->
    <div class="property-gallery">

        <!-- MAIN MEDIA -->
        <div class="main-media" id="mainMedia">
            @if (Model.Images != null && Model.Images.Any())
            {
                <img src="@Model.Images.First()" class="media-fit" />
            }
            else if (!string.IsNullOrEmpty(Model.VideoPath))
            {
                <video src="@Model.VideoPath" controls class="media-fit"></video>
            }
            else
            {
                <img src="~/images/no-image.png" class="media-fit" />
            }
        </div>

        <!-- THUMBNAILS -->
        <div class="thumbnail-row">
            @if (Model.Images != null)
            {
                foreach (var img in Model.Images)
                {
                    <div class="thumb" onclick="showImage('@img')">
                        <img src="@img" />
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(Model.VideoPath))
            {
                <div class="thumb video-thumb"
                     onclick="showVideo('@Model.VideoPath')">
                    <video src="@Model.VideoPath"></video>
                </div>
            }
        </div>

    </div>

    <!-- RIGHT : INFO -->
    <div class="property-info-card">
        <p class="property-location">@Model.Location</p>
        <h1>@Model.Title</h1>

        <div class="price">
            ₹ @Model.Price.ToString("N0", new System.Globalization.CultureInfo("en-IN"))
        </div>

        <p>@Model.Description</p>

        <div class="property-actions">
            <a href="tel:@whatsAppNumber" class="btn-call" onclick="logEnquiry()">Call Now</a>
            <a href="@whatsappUrl" target="_blank" class="btn-whatsapp" onclick="logEnquiry()">WhatsApp</a>
        </div>
    </div>

</section>
</section>

<script>
    function showImage(src) {
        document.getElementById("mainMedia").innerHTML =
            `<img src="${src}" class="media-fit" />`;
    }

    function showVideo(src) {
        document.getElementById("mainMedia").innerHTML =
            `<video src="${src}" controls autoplay class="media-fit"></video>`;
    }

    function logEnquiry() {
        fetch('/Property/LogEnquiry?propertyId=@Model.PropertyId', {
            method: 'POST',
            keepalive: true
        }).catch(function () { /* best-effort logging, never block navigation */ });
    }
</script>
