@model EditPropertyViewModel
@{
    ViewData["Title"] = "Edit Property";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="~/css/property-update.css" rel="stylesheet" asp-append-version="true" />

<div class="edit-property-container">
    <h2>Edit Property</h2>
    <p class="edit-subtitle">Update property details and manage media</p>

    <form asp-action="EditProperty"
          asp-controller="Property"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PropertyId" />

        <div asp-validation-summary="All" class="validation-summary"></div>

        <!-- ================= TITLE ================= -->
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <!-- ================= LOOKING FOR ================= -->
        <div class="mb-3">
            <label class="form-label d-block">Looking For</label>

            <div class="segmented">
                <label>
                    <input type="radio" asp-for="LookingFor" value="1" />
                    Rent
                </label>
                <label>
                    <input type="radio" asp-for="LookingFor" value="2" />
                    Buy
                </label>
                <label>
                    <input type="radio" asp-for="LookingFor" value="3" />
                    Sell
                </label>
            </div>
        </div>

        <!-- ================= BHK ================= -->
        <div class="mb-3">
            <label class="form-label">BHK</label>
            <select asp-for="BHK" class="form-select" required>
                <option value="">-- Select BHK --</option>
                @for (int i = 1; i <= 4; i++)
                {
                    <option value="@i">@i BHK</option>
                }
            </select>
        </div>

        <!-- ================= FEATURED ================= -->
        <div class="mb-3 form-check">
            <input asp-for="IsFeatured" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="IsFeatured">
                Featured — show in the auto-scrolling panel on the Home page
            </label>
        </div>

        <!-- ================= LOCATION ================= -->
        <div class="mb-3">
            <label class="form-label">Location</label>
            <select asp-for="LocationId" class="form-select" required>
                <option value="">-- Select Location --</option>
                @foreach (var loc in ViewBag.Locations)
                {
                    <option value="@loc.Id">@loc.LocationName</option>
                }
            </select>
        </div>

        <!-- ================= PRICE ================= -->
        <div class="mb-3">
            <label class="form-label">Price</label>
            <input asp-for="Price"
                   class="form-control"
                   min="0"
                   onkeydown="if(event.key==='-') event.preventDefault();"
                   required />
        </div>

        <!-- ================= DESCRIPTION ================= -->
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      required></textarea>
        </div>

        <hr class="form-divider" />

        <!-- ================= EXISTING IMAGES ================= -->
        <label class="fw-bold mb-2">Property Images</label>

        <div id="imageGrid" class="image-grid mb-3">
            @foreach (var img in Model.ExistingImages)
            {
                <div class="image-card existing">
                    <img src="@img.ImagePath" />

                    <button type="button"
                            class="remove-btn"
                            onclick="markExistingImageForRemoval(this)">
                        ×
                    </button>

                    <input type="hidden"
                           name="RemoveImageIds"
                           value="@img.ImageId"
                           disabled />
                </div>
            }
        </div>

        <!-- ================= NEW IMAGES ================= -->
        <div class="mb-3">
            <label class="form-label">Add New Images</label>
            <input type="file"
                   id="newImagesInput"
                   name="NewImages"
                   class="form-control"
                   multiple
                   accept=".jpg,.jpeg,.png,.webp" />
        </div>

        <hr class="form-divider" />

        <!-- ================= VIDEO ================= -->
        <label class="fw-bold mb-2">Property Video</label>

        @if (!string.IsNullOrEmpty(Model.ExistingVideoPath))
        {
            <div class="mb-2">
                <div class="video-preview">
                    <video controls>
                        <source src="@Model.ExistingVideoPath" type="video/mp4" />
                    </video>
                </div>

                <div class="form-check mt-2">
                    <input class="form-check-input"
                           type="checkbox"
                           asp-for="RemoveVideo" />
                    <label class="form-check-label">
                        Remove existing video
                    </label>
                </div>
            </div>
        }

        <div class="mb-3">
            <input type="file"
                   id="NewVideo"
                   name="NewVideo"
                   class="form-control"
                   accept="video/mp4,video/webm,video/ogg" />
            <small class="text-muted">Upload to replace existing video · Max 20MB · Max 1920px on the longer side</small>
            <small id="videoError" class="d-block" style="color:var(--rust);"></small>
        </div>

        <!-- ================= ACTIONS ================= -->
        <div class="edit-actions">
            <button type="submit" class="btn btn-primary">
                Update Property
            </button>

            <a asp-action="Dashboard"
               asp-controller="Admin"
               class="btn btn-secondary">
                Cancel
            </a>
        </div>

    </form>
</div>

<script>
    const newImagesInput = document.getElementById("newImagesInput");
    const imageGrid = document.getElementById("imageGrid");

    let newFiles = [];

    newImagesInput.addEventListener("change", function () {
        Array.from(this.files).forEach(file => {
            if (!file.type.startsWith("image/")) return;

            newFiles.push(file);
            renderNewImage(file, newFiles.length - 1);
        });

        syncNewFiles();
    });

    function renderNewImage(file, index) {
        const reader = new FileReader();

        reader.onload = e => {
            const card = document.createElement("div");
            card.className = "image-card new";

            card.innerHTML = `
                <img src="${e.target.result}">
                <button type="button"
                        class="remove-btn"
                        onclick="removeNewImage(${index})">×</button>
            `;

            imageGrid.appendChild(card);
        };

        reader.readAsDataURL(file);
    }

    function removeNewImage(index) {
        newFiles.splice(index, 1);
        rebuildGrid();
        syncNewFiles();
    }

    function rebuildGrid() {
        document.querySelectorAll(".image-card.new").forEach(e => e.remove());
        newFiles.forEach((file, i) => renderNewImage(file, i));
    }

    function syncNewFiles() {
        const dt = new DataTransfer();
        newFiles.forEach(f => dt.items.add(f));
        newImagesInput.files = dt.files;
    }

    function markExistingImageForRemoval(btn) {
        const card = btn.closest(".image-card");
        card.classList.toggle("marked-for-delete");

        const hiddenInput = card.querySelector("input[type='hidden']");
        hiddenInput.disabled = !hiddenInput.disabled;
    }

    // Videos aren't resized server-side (no transcoding infra on this
    // host), so this is the only place resolution ever gets checked —
    // catch it here with real feedback rather than a silent-looking crop.
    const videoInput = document.getElementById("NewVideo");
    const videoError = document.getElementById("videoError");
    const MAX_VIDEO_BYTES = 20 * 1024 * 1024;
    const MAX_VIDEO_DIMENSION = 1920;

    videoInput.addEventListener("change", function () {
        videoError.textContent = "";
        const file = this.files[0];
        if (!file) return;

        if (file.size > MAX_VIDEO_BYTES) {
            videoError.textContent = `That video is ${(file.size / (1024 * 1024)).toFixed(1)}MB — please compress it or trim the clip to under 20MB.`;
            this.value = "";
            return;
        }

        const probe = document.createElement("video");
        probe.preload = "metadata";
        probe.onloadedmetadata = function () {
            URL.revokeObjectURL(probe.src);
            if (probe.videoWidth > MAX_VIDEO_DIMENSION || probe.videoHeight > MAX_VIDEO_DIMENSION) {
                videoError.textContent = `That video is ${probe.videoWidth}×${probe.videoHeight} — please export at 1920px or smaller on the longer side.`;
                videoInput.value = "";
            }
        };
        probe.src = URL.createObjectURL(file);
    });
</script>
