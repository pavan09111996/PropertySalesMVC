@model EditPropertyViewModel
@{
    ViewData["Title"] = "Edit Property";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="~/css/property-update.css" rel="stylesheet" />

<div class="edit-property-container">
    <h2>Edit Property</h2>
    <p class="edit-subtitle">Update property details and manage media</p>

    <form asp-action="EditProperty"
          asp-controller="Property"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PropertyId" />

        <!-- ================= TITLE ================= -->
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <!-- ================= LOOKING FOR ================= -->
        <div class="mb-3">
            <label class="fw-bold d-block">Looking For</label>

            <div class="form-check form-check-inline">
                <input class="form-check-input"
                       type="radio"
                       asp-for="LookingFor"
                       value="1" />
                <label class="form-check-label">Rent</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input"
                       type="radio"
                       asp-for="LookingFor"
                       value="2" />
                <label class="form-check-label">Buy</label>
            </div>

            <div class="form-check form-check-inline">
                <input class="form-check-input"
                       type="radio"
                       asp-for="LookingFor"
                       value="3" />
                <label class="form-check-label">Sell</label>
            </div>
        </div>

        <!-- ================= BHK ================= -->
        <div class="mb-3">
            <label class="form-label">BHK</label>
            <select asp-for="BHK" class="form-select" required>
                <option value="">-- Select BHK --</option>
                @for (int i = 1; i <= 4; i++)
                {
                    <option value="@i">@i BHK</option>
                }
            </select>
        </div>

        <!-- ================= LOCATION ================= -->
        <div class="mb-3">
            <label class="form-label">Location</label>
            <select asp-for="LocationId" class="form-select" required>
                <option value="">-- Select Location --</option>
                @foreach (var loc in ViewBag.Locations)
                {
                    <option value="@loc.Id">@loc.LocationName</option>
                }
            </select>
        </div>

        <!-- ================= PRICE ================= -->
        <div class="mb-3">
            <label class="form-label">Price</label>
            <input asp-for="Price"
                   class="form-control"
                   min="0"
                   onkeydown="if(event.key==='-') event.preventDefault();"
                   required />
        </div>

        <!-- ================= DESCRIPTION ================= -->
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      required></textarea>
        </div>

        <hr class="form-divider" />

        <!-- ================= EXISTING IMAGES ================= -->
        <label class="fw-bold mb-2">Property Images</label>

        <div id="imageGrid" class="image-grid mb-3">
            @foreach (var img in Model.ExistingImages)
            {
                <div class="image-card existing">
                    @if (!string.IsNullOrEmpty(img.ImagePath))
                    {
                        <img src="@img.ImagePath" />
                    }
                    else
                    {
                        <img src="data:image/jpeg;base64,@img.ImageBase64" />
                    }

                    <button type="button"
                            class="remove-btn"
                            onclick="markExistingImageForRemoval(this)">
                        ×
                    </button>

                    <input type="hidden"
                           name="RemoveImageIds"
                           value="@img.ImageId"
                           disabled />
                </div>
            }
        </div>

        <!-- ================= NEW IMAGES ================= -->
        <div class="mb-3">
            <label class="form-label">Add New Images</label>
            <input type="file"
                   id="newImagesInput"
                   name="NewImages"
                   class="form-control"
                   multiple
                   accept=".jpg,.jpeg,.png,.webp" />
        </div>

        <hr class="form-divider" />

        <!-- ================= VIDEO ================= -->
        <label class="fw-bold mb-2">Property Video</label>

        @if (!string.IsNullOrEmpty(Model.ExistingVideoPath))
        {
            <div class="mb-2">
                <video controls width="100%" style="max-height:280px">
                    <source src="@Model.ExistingVideoPath" type="video/mp4" />
                </video>

                <div class="form-check mt-2">
                    <input class="form-check-input"
                           type="checkbox"
                           asp-for="RemoveVideo" />
                    <label class="form-check-label">
                        Remove existing video
                    </label>
                </div>
            </div>
        }

        <div class="mb-3">
            <input type="file"
                   name="NewVideo"
                   class="form-control"
                   accept="video/mp4,video/webm,video/ogg" />
            <small class="text-muted">Upload to replace existing video</small>
        </div>

        <!-- ================= ACTIONS ================= -->
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                Update Property
            </button>

            <a asp-action="Dashboard"
               asp-controller="Admin"
               class="btn btn-secondary ms-2">
                Cancel
            </a>
        </div>

    </form>
</div>

<script>
    const newImagesInput = document.getElementById("newImagesInput");
    const imageGrid = document.getElementById("imageGrid");

    let newFiles = [];

    newImagesInput.addEventListener("change", function () {
        Array.from(this.files).forEach(file => {
            if (!file.type.startsWith("image/")) return;

            newFiles.push(file);
            renderNewImage(file, newFiles.length - 1);
        });

        syncNewFiles();
    });

    function renderNewImage(file, index) {
        const reader = new FileReader();

        reader.onload = e => {
            const card = document.createElement("div");
            card.className = "image-card new";

            card.innerHTML = `
                <img src="${e.target.result}">
                <button type="button"
                        class="remove-btn"
                        onclick="removeNewImage(${index})">×</button>
            `;

            imageGrid.appendChild(card);
        };

        reader.readAsDataURL(file);
    }

    function removeNewImage(index) {
        newFiles.splice(index, 1);
        rebuildGrid();
        syncNewFiles();
    }

    function rebuildGrid() {
        document.querySelectorAll(".image-card.new").forEach(e => e.remove());
        newFiles.forEach((file, i) => renderNewImage(file, i));
    }

    function syncNewFiles() {
        const dt = new DataTransfer();
        newFiles.forEach(f => dt.items.add(f));
        newImagesInput.files = dt.files;
    }

    function markExistingImageForRemoval(btn) {
        const card = btn.closest(".image-card");
        card.classList.toggle("marked-for-delete");

        const hiddenInput = card.querySelector("input[type='hidden']");
        hiddenInput.disabled = !hiddenInput.disabled;
    }
</script>
