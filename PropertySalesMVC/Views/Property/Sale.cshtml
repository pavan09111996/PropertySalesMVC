@model PropertySalesMVC.Models.PropertyViewModel
@{
    ViewData["Title"] = "Sell Property - Ronak Estate";
}

<link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />

<section class="form-page">
    <div class="form-shell">
        @* No eyebrow/h1 here on purpose: this view doubles as a partial
           (SalePartial) injected into Home's #propertyContainer, right
           below Home's own "Sell With Ronak Estate" section heading —
           repeating it here would read as a duplicate. *@
        <p class="lede">A few details is all we need — our team will reach out to arrange a valuation and next steps.</p>

        <form asp-action="Sale" asp-controller="Property" method="post" class="form-card" autocomplete="off">

            @Html.AntiForgeryToken()

            <div class="field">
                <label>Address of the property</label>
                <input type="text" name="Title" required />
            </div>

            <div class="field-row">
                <div class="field">
                    <label>BHK</label>
                    <select name="BHK" required>
                        <option value="">-- Select BHK --</option>
                        <option value="1">1 BHK</option>
                        <option value="2">2 BHK</option>
                        <option value="3">3 BHK</option>
                        <option value="4">4 BHK</option>
                    </select>
                </div>

                <div class="field">
                    <label>Expected Price</label>
                    <input type="number" name="Price" required />
                </div>
            </div>

            @* <div class="field">
                <label>Location</label>
                <select name="Location" required>
                    <option value="">-- Select Location --</option>
                    @foreach (var loc in ViewBag.Locations)
                    {
                        <option value="@loc.Id">@loc.Location</option>
                    }
                </select>
            </div> *@

            <div class="field">
                <label>Description</label>
                <textarea name="Description" rows="4" required></textarea>
            </div>

            <button type="submit" class="btn-brass-block">
                Submit Property
            </button>

        </form>
    </div>
</section>
