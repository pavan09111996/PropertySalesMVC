@{
    ViewData["Title"] = "Sell Property - Ronak Estate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" />
}

<!-- HERO -->
<section class="hero hero-video">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>
            Sell Your <span class="gold-accent">Property</span>
        </h1>
        <p>List your property for sale with Ronak Estate</p>
    </div>
</section>

<!-- FORM SECTION -->
<section class="properties-section">
    <h2 class="section-title">Submit Property for Sale</h2>

    <div class="container" style="max-width: 700px;">

        <form id="saleForm" class="card p-4 shadow-sm">

            <!-- Property Title -->
            <div class="mb-3">
                <label class="form-label">Property Title</label>
                <input type="text" class="form-control" name="Title" required />
            </div>

            <!-- BHK -->
            <div class="mb-3">
                <label class="form-label">BHK</label>
                <select class="form-select" name="BHK" required>
                    <option value="">-- Select BHK --</option>
                    <option value="1">1 BHK</option>
                    <option value="2">2 BHK</option>
                    <option value="3">3 BHK</option>
                    <option value="4">4 BHK</option>
                </select>
            </div>

            <!-- Location -->
            <div class="mb-3">
                <label class="form-label">Location</label>
                <select class="form-select" name="Location" required>
                    <option value="">-- Select Location --</option>
                    @foreach (var loc in ViewBag.Locations)
                    {
                        <option value="@loc.Id">@loc.Location</option>
                    }
                </select>
            </div>

            <!-- Expected Price -->
            <div class="mb-3">
                <label class="form-label">Expected Price</label>
                <input type="number" class="form-control" name="Price" min="0" required />
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" name="Description" rows="4" required></textarea>
            </div>

            

            <!-- Hidden LookingFor -->
            <input type="hidden" name="LookingFor" value="Sale" />

            <button type="submit" class="btn-primary w-100">Submit Property</button>
        </form>
    </div>
</section>

@section Scripts {
    <script>
                const form = document.getElementById("saleForm");

                form.addEventListener("submit", function (e) {
                    e.preventDefault(); // Prevent default form submission

                    const formData = new FormData(form);
                    const title = formData.get("Title");
                    const location = formData.get("Location");
                    const bhk = formData.get("BHK");
                    const price = formData.get("Price");

                    const locationName = {
                        "1": "Borivali",
                        "2": "Kandivali",
                        "3": "Goregaon",
                        "4": "Malad"
                    }[location] || "Unknown";

                    const message = `Hello Ronak Estate 👋
        I would like to sell my property 🏠

        Property Details
        Title: ${title}
        Location: ${locationName}
        BHK: ${bhk}
        Expected Price: ₹${parseInt(price).toLocaleString()}

        Please contact me for further discussion.
        Thank you 🙂`;

                    const phoneNumber = "919594774795";
                    const url = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;

                    // Open WhatsApp in a new tab
                    window.open(url, "_blank");

                    // Reset the form
                    form.reset();
                });
    </script>
}
