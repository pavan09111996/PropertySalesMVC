@model List<PropertyViewModel>

@{
    ViewData["Title"] = "Ronak Estate - Property Listings";

    string mode = ViewBag.Mode ?? "Rent";
    int? selectedLocation = ViewBag.SelectedLocation as int?;
    int? selectedBHK = ViewBag.SelectedBHK as int?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/listing-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/listing-pages.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-inner">
        <div class="mode-switch">
            <a href="/Property/Buy" class="@(mode == "Buy" ? "active" : "")">Buy</a>
            <a href="/Property/Rent" class="@(mode == "Rent" ? "active" : "")">Rent</a>
            <a href="/Property/Sell" class="@(mode == "Sell" ? "active" : "")">Sell</a>
        </div>
        <h1>Explore Properties for <span class="gold-accent">@mode</span></h1>
        <p>Handpicked homes across Borivali &amp; Kandivali, available for @mode.ToLower().</p>
    </div>
</div>

<div class="listing-filter">
    <form method="get" class="rf-form">
        <div class="rf-group">
            <label class="rf-label">Location</label>
            <select name="locationId" class="rf-select">
                <option value="">All Locations</option>

                @foreach (var loc in ViewBag.Locations)
                {
                    bool isSelected = selectedLocation == Convert.ToInt32(loc.Id);

                    <option value="@loc.Id" selected="@(isSelected ? "selected" : null)">
                        @loc.Location
                    </option>
                }
            </select>
        </div>

        <div class="rf-group">
            <label class="rf-label">BHK</label>
            <select name="bhk" class="rf-select">
                <option value="">Any BHK</option>

                @for (int i = 1; i <= 4; i++)
                {
                    bool isSelected = selectedBHK == i;

                    <option value="@i" selected="@(isSelected ? "selected" : null)">
                        @i BHK
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="rf-btn">
            Apply Filters
        </button>
    </form>
</div>

<section class="properties-section">
    @await Html.PartialAsync("_PropertyGrid", Model)
</section>
