@model List<PropertyViewModel>

@{
    ViewData["Title"] = "Ronak Estate - Property Listings";

    string mode = ViewBag.Mode ?? "Rent";
    int? selectedLocation = ViewBag.SelectedLocation as int?;
    int? selectedBHK = ViewBag.SelectedBHK as int?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" />
}

<!-- ================= HERO ================= -->
<section class="hero hero-video">

    <video class="hero-bg-video"
           autoplay muted loop playsinline preload="metadata"
           poster="/images/hero-fallback.jpg">
        <source src="/videos/realestate-timelapse.mp4" type="video/mp4" />
    </video>

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <h1>
            Explore Properties for <span class="gold-accent">@mode</span>
        </h1>

        <div class="hero-actions">
            <a href="/Property/Buy"  class="@(mode=="Buy"?"active":"")">Buy</a>
            <a href="/Property/Rent" class="@(mode=="Rent"?"active":"")">Rent</a>
            <a href="/Property/Sell" class="@(mode=="Sell"?"active":"")">Sell</a>
        </div>

        <p>Handpicked premium properties available for @mode.ToLower()</p>

    </div>
</section>

<!-- ================= FILTER ================= -->
<div class="listing-filter rf-filter">
    <form method="get" class="rf-form">

        <div class="rf-group">
            <label class="rf-label">Location</label>
            <select name="locationId" class="rf-select">
                <option value="">All Locations</option>

                @foreach (var loc in ViewBag.Locations)
                {
                    <option value="@loc.Id"
                            selected="@(selectedLocation == Convert.ToInt32(loc.Id))">
                        @loc.Location
                    </option>
                }
            </select>
        </div>

        <div class="rf-group">
            <label class="rf-label">BHK</label>
            <select name="bhk" class="rf-select">
                <option value="">Any BHK</option>

                @for (int i = 1; i <= 4; i++)
                {
                    <option value="@i"
                            selected="@(selectedBHK == i)">
                        @i BHK
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="rf-btn">
            Apply Filters
        </button>

    </form>
</div>

<!-- ================= LISTING ================= -->
<section class="properties-section">

    <h2 class="section-title">Featured @mode Properties</h2>

    @await Html.PartialAsync("_PropertyGrid", Model)

</section>
