@using PropertySalesMVC.Helpers
@using Microsoft.AspNetCore.Http

@if (TempData["SuccessMessage"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-4" style="z-index: 1200;">
        <div id="successToast"
             class="toast border-0 shadow-lg"
             role="alert"
             aria-live="assertive"
             aria-atomic="true"
             data-bs-delay="4000">

            <div class="toast-body d-flex align-items-center gap-2"
                 style="background: linear-gradient(135deg, #198754, #28a745); color: white; border-radius: 8px;">

                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>

        </div>
    </div>
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ronak Estate</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Global Styles -->
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Page Styles -->
    @RenderSection("Styles", required: false)

    <script src="~/js/adminlogin.js"></script>
</head>

<body>

    <!-- ===============================
         HEADER / NAVBAR
    ================================ -->
    <header class="site-header">
        <nav class="navbar navbar-expand-lg container">

            <!-- LOGO -->
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="~/images/ronak-logo.png"
                     alt="Ronak Estate"
                     class="logo" />
            </a>

            <!-- MOBILE TOGGLER -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- NAV LINKS -->
            <div class="collapse navbar-collapse justify-content-end" id="mainNav">
                <ul class="navbar-nav align-items-center gap-3">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Contact">Contact</a>
                    </li>

                    <li class="nav-item">
                        <a href="/Admin/Login"
                           class="btn-admin-login"
                           data-bs-toggle="modal"
                           data-bs-target="#adminLoginModal">
                            Login
                        </a>
                    </li>

                </ul>
            </div>
        </nav>
    </header>

    <!-- ===============================
         MAIN CONTENT
    ================================ -->
    <main class="site-main">
        @RenderBody()
    </main>

    <!-- ===============================
         FOOTER
    ================================ -->
    <footer class="site-footer">
        <div class="container">
            <div class="row text-center text-md-start">

                <div class="col-md-4 mb-4">
                    <h5 class="footer-title">@ViewBag.CompanyName</h5>
                    <p class="mb-1 fw-semibold">@ViewBag.OwnerName</p>
                    <p class="text-muted">@ViewBag.Designation</p>
                </div>

                <div class="col-md-4 mb-4">
                    <h6 class="footer-heading">@ViewBag.HeadOfficeTitle</h6>
                    <p class="footer-text">@ViewBag.HeadOfficeAddress</p>
                </div>

                <div class="col-md-4 mb-4">
                    <h6 class="footer-heading">@ViewBag.BranchOfficeTitle</h6>
                    <p class="footer-text">@ViewBag.BranchOfficeAddress</p>
                </div>
            </div>

            <hr>

            <div class="footer-bottom d-flex justify-content-between align-items-center flex-wrap">
                <span>
                    © @DateTime.Now.Year <strong>@ViewBag.CompanyName</strong>. All Rights Reserved.
                </span>

                <div class="social-icons">
                    @if (ViewBag.InstagramUrl != null)
                    {
                        <a href="@ViewBag.InstagramUrl" target="_blank">
                            <i class="fab fa-instagram"></i>
                        </a>
                    }
                    @if (ViewBag.FacebookUrl != null)
                    {
                        <a href="@ViewBag.FacebookUrl" target="_blank">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </footer>

    <!-- ===============================
         ADMIN LOGIN MODAL
    ================================ -->
    <div class="modal fade premium-admin-modal"
         id="adminLoginModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="premium-header">
                    <div>
                        <h4>Admin Access</h4>
                        <p>Authorized personnel only</p>
                    </div>

                    <button type="button"
                            class="premium-close"
                            data-bs-dismiss="modal">
                        ×
                    </button>
                </div>

                <div class="premium-body">
                    <div class="premium-field">
                        <label>Admin ID</label>
                        <input type="text" id="AdminID" class="premium-input">
                    </div>

                    <div class="premium-field">
                        <label>Password</label>
                        <input type="password" id="AdminPassword" class="premium-input">
                    </div>

                    <div id="loginError" class="premium-error"></div>
                </div>

                <div class="premium-footer">
                    <button class="btn-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn-login" onclick="submitAdminLogin()">Login</button>
                </div>

            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toastEl = document.getElementById('successToast');
            if (toastEl) {
                new bootstrap.Toast(toastEl, { delay: 4000 }).show();
            }

            const adminModal = document.getElementById("adminLoginModal");
            if (adminModal) {
                adminModal.addEventListener("hidden.bs.modal", function () {
                    document.getElementById("loginError").innerText = "";
                    document.getElementById("AdminPassword").value = "";
                });
            }
        });
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
