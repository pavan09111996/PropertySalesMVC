@model PropertyViewModel

<a href="@Url.Action("PropertyDetails", "Property", new { id = Model.PropertyId })"
   class="property-card"
   target="_blank"
   rel="noopener">

    <!-- IMAGE -->
    <div class="property-image">
        <span class="featured-badge">@Model.BHK BHK</span>

        <img
            src="@Model.ImagePath"
            alt="@Model.Title"
            loading="lazy"
            onerror="this.onerror=null;this.src='/images/no-image.jpg';" />
    </div>

    <!-- BODY -->
    <div class="property-body">

        <p class="property-location">@Model.Location</p>

        <h3 class="property-title">@Model.Title</h3>

        <p class="property-desc">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "No description available"
                : Model.Description.Length > 90
                    ? Model.Description.Substring(0, 90) + "..."
                    : Model.Description)
        </p>

        <div class="property-footer">
            <p class="property-price tabular">
                ₹ @Model.Price.ToString("N0", new System.Globalization.CultureInfo("en-IN"))
            </p>
        </div>

    </div>
</a>
